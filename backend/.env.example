# backend/.env : backend-specific settings.
#
# Shared values (DATABASE_URL, Clerk keys) are read from the repo-root .env /
# .env.local, the same files Next.js uses. Precedence, lowest to highest:
#   ../.env  ->  ../.env.local  ->  backend/.env  ->  real environment
#
# The defaults below need NO credentials: mock providers generate, and local
# storage materializes real playable files. Clone, `uv sync`, run.

# ---------------------------------------------------------------- modes ----
# mock = GenBlaze's bundled mock providers; live = real provider adapters
#        (needs `uv sync --extra providers` plus the API keys below).
GENBLAZE_MODE=mock
# local = write generated media under backend/.data/media and serve it at /media
# b2    = upload to Backblaze B2 with a provenance manifest (needs B2_* below)
STORAGE_MODE=local

# ----------------------------------------------------------------- auth ----
# Skips Clerk JWT verification and trusts an `X-Dev-User` header. Local only:
# create_app() refuses to start with this enabled when APP_ENV=production.
AUTH_DEV_BYPASS=true

# CLERK_ISSUER is normally left unset: it is derived from
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, which the frontend already has.
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Comma-separated `azp` values to accept. Set this in production: it stops a
# token minted for a different frontend being replayed against this API.
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://assetflow.vercel.app

# ------------------------------------------------------------------ app ----
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --------------------------------------------------------------- worker ----
# true  = the worker runs inside the API process (one command for local dev)
# false = run it separately with `uv run python -m app.workers`
RUN_WORKER_IN_PROCESS=true
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=90
PER_TENANT_RUN_LIMIT=3
STEP_TIMEOUT_SECONDS=600
# Video generations routinely outlive the default ceiling; plans containing a
# video step poll up to this long instead.
VIDEO_STEP_TIMEOUT_SECONDS=1800

# ------------------------------------------------------- Backblaze B2 ------
# Required only when STORAGE_MODE=b2. Create a *standard* bucket-scoped
# application key (never the master key: it cannot be used with the
# S3-compatible API). keyID -> B2_KEY_ID, applicationKey -> B2_APP_KEY; the
# secret is shown exactly once. See docs/b2-setup.md, and verify with
# `uv run python -m app.scripts.b2_doctor`.
# B2_KEY_ID=
# B2_APP_KEY=
# B2_BUCKET=assetflow-media-xxxx
# Must match the bucket's real region (from the endpoint, e.g.
# s3.us-east-005.backblazeb2.com -> us-east-005). This one MUST be explicit:
# a wrong-region request gets a bare 403 instead of a redirect, so it cannot
# be auto-detected and the failure looks exactly like bad credentials.
# B2_REGION=us-west-004
# B2_PREFIX=assetflow

# --------------------------------------------------- provider API keys ------
# Only needed with GENBLAZE_MODE=live, and only for the providers you use.
# Every model stays listed in the catalog either way: unavailable ones are
# reported with the reason instead of being hidden.
# GMI_API_KEY=               # GMI Cloud: Seedance / Kling v3 video, Seedream
#                            # image, Kling Lip Sync, Hunyuan 3D Pro
# REPLICATE_API_TOKEN=       # Replicate: Nano Banana, GPT Image, Sora 2,
#                            # PixVerse lipsync, Qwen edits, Ideogram Layerize
# RUNWAYML_API_SECRET=       # Runway: Gen-4.5, Gen-4 Turbo/Image, Recipes
# LUMAAI_API_KEY=            # Luma: Ray 3.2 video, Uni-1 image
# ELEVENLABS_API_KEY=        # ElevenLabs: speech, music, SFX, Scribe
# DECART_API_KEY=            # Decart: Lucy video editing, try-on, image edit
#
# Two features ride on keys above regardless of the catalog:
# REPLICATE_API_TOKEN also drives the LLM node (Kimi K2.6, text-to-text), and
# GMI_API_KEY also drives enrichment's vision pass (captions, tags, OCR)
# through GenBlaze's chat connector: see ENRICH_VISION_MODEL below.

# ------------------------------------------------- enrichment + search ------
# Kill switch for the background enrichment pipeline (vision captions, tags,
# OCR, embeddings). Enrichment failing never takes uploads or runs down.
ENRICH_ENABLED=true
# Vision model for enrichment, served through GMI Cloud's chat endpoint.
# ENRICH_VISION_MODEL=google/gemini-3.1-flash-lite-preview
# Jina embeddings (jina-embeddings-v3) power vector search. Without this key,
# search degrades to keyword-only and enrichment stores text without vectors.
# JINA_API_KEY=
